# Copy this file to .env and fill in real values. Never commit .env.

# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — full DB access, server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (platform.openai.com/api-keys) — server-side only.
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

# No public sign-up: students/teachers log in with a nickname + password.
# The nickname is turned into a synthetic email at this domain for Supabase Auth.
NICKNAME_DOMAIN=students.worksheet.local
# Temporary password assigned to new/reset accounts, which they must change
# on first login. Supabase requires >=6 characters by default — to use the
# literal password "1", lower the minimum length in the Supabase dashboard
# (Authentication > Policies) and set this to 1.
DEFAULT_STUDENT_PASSWORD=111111

PORT=3000
